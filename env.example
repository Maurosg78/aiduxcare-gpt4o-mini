# ========================================
# AiDuxCare GPT4O Mini - HYPERION Architecture
# Variables de Entorno - Fase 1: Fundación RAG
# ========================================

# ========================================
# SUPABASE CONFIGURATION
# ========================================
# URL de tu proyecto Supabase
SUPABASE_URL=https://your-project.supabase.co

# Clave anónima de Supabase (pública, segura para el cliente)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Clave de servicio de Supabase (privada, solo para el servidor)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ========================================
# AZURE OPENAI CONFIGURATION
# ========================================
# Endpoint de Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Clave de API de Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

# Nombre del deployment del modelo de chat (ej: gpt-4)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4

# Nombre del deployment del modelo de embeddings (ej: text-embedding-ada-002)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Versión de la API de Azure OpenAI
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ========================================
# VECTOR STORE CONFIGURATION
# ========================================
# Nombre de la tabla en Supabase para almacenar embeddings
VECTOR_STORE_TABLE_NAME=clinical_documents

# Número de documentos similares a recuperar por consulta
VECTOR_STORE_TOP_K=5

# Umbral de similitud mínima para considerar un documento relevante (0-1)
VECTOR_STORE_SIMILARITY_THRESHOLD=0.7

# ========================================
# APPLICATION CONFIGURATION
# ========================================
# Entorno de la aplicación
NODE_ENV=development

# Puerto del servidor de desarrollo
PORT=3000

# URL base de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================
# SECURITY CONFIGURATION
# ========================================
# Clave de cifrado para datos sensibles (mínimo 32 caracteres)
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Clave secreta para JWT (mínimo 32 caracteres)
JWT_SECRET=your-32-character-jwt-secret-here

# ========================================
# LOGGING CONFIGURATION
# ========================================
# Nivel de logging (debug, info, warn, error)
LOG_LEVEL=info

# ========================================
# DEVELOPMENT TOOLS
# ========================================
# Habilitar logs detallados en desarrollo
DEBUG=aiduxcare:*

# ========================================
# NOTAS IMPORTANTES
# ========================================
# 1. NUNCA commits este archivo con valores reales
# 2. Copia este archivo como .env.local y llena los valores reales
# 3. Asegúrate de que ENCRYPTION_KEY y JWT_SECRET tengan al menos 32 caracteres
# 4. Para producción, usa variables de entorno del servidor
# 5. Verifica que tu proyecto Supabase tenga la extensión pgvector habilitada 